# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
# And the example app's, for the same reason plus one more: it resolves
# differently on every Flutter SDK, so `flutter pub get` on a runner newer
# than the last committer's left the tree dirty, and `pub publish --dry-run`
# refuses a dirty tree.
example/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Working rules for the agent. This repo is public; these are not.
# The copy that counts lives in relavoi-infra/agent/relavoi-flutter-sdk/ and is restored
# here by relavoi-infra/scripts/sync-agent-docs.sh. Ignored so that a file
# left on disk can never be committed back into a public history.
CLAUDE.md
AGENTS.md
BACKLOG.md
docs/backlog.md
